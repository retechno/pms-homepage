# Every value is optional. A link or form whose value is empty is not shown.
# Address of the KamaraPMS application; "Log in" goes to <VITE_APP_URL>/login.
VITE_APP_URL=
# Where the demo request form is POSTed (a form service or your own endpoint, JSON body).
VITE_DEMO_ENDPOINT=
# Sales address shown in the demo section and the footer, and used when no endpoint is set.
VITE_SALES_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
